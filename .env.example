# Copy to .env. Live Meta calls stay off until META_API_MOCK=0.
META_AI_API_KEY=""
HUGGINGFACE_TOKEN=""
DATASET_ROOT="./data"
OUTPUT_DIR="./artifacts"

# Placeholder endpoint for the Meta model API wrapper in src/teacher/meta_client.py.
META_API_BASE_URL="https://api.meta.ai/v1"
# "1" (default) builds request payloads and returns local mocks. "0" performs HTTP.
META_API_MOCK="1"
